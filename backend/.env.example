PORT=5000

# Frontend origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://your-portfolio.vercel.app,http://localhost:8000

# MongoDB Atlas connection string — stores every contact message
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio

# Email alerts — where new messages are sent
CONTACT_TO=you@gmail.com

# Option A (recommended, works on Render free plan): Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Optional. Without a verified domain, keep the default and use your Resend login email as CONTACT_TO.
# RESEND_FROM=Portfolio <onboarding@resend.dev>

# Option B (fallback, used only if RESEND_API_KEY is empty): SMTP / Gmail App Password
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
